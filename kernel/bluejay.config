# Config fragment for the Pixel 6a (bluejay), merged after halium.config.
#
# Keep Bluetooth and rfkill as loadable modules, as in the stock GKI kernel
# (6.1.145-android14-11-gc1de4747ac59: CONFIG_BT=m, CONFIG_RFKILL=m).
# halium.config makes them built-in (=y). The stock vendor_dlkm then has
# rfkill.ko, bluetooth.ko, hidp.ko and rfcomm.ko that the kernel rejects
# ("exports duplicate symbol ... (owned by kernel)" or "module is already
# loaded"), and Android's libmodprobe then refuses every module whose
# modules.dep entry lists rfkill.ko: cfg80211, mac80211, bcmdhd4389 (Wi-Fi),
# nitrous (Bluetooth power) and nfc.
CONFIG_RFKILL=m
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIVHCI=m
